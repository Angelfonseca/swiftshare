{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "swiftshare",
  "version": "0.1.0",
  "identifier": "com.swiftshare.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "swiftshare",
        "url": "index.html",
        "width": 920,
        "height": 760,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
